# ─── Application ───────────────────────────────────────────────────────────────
# REQUIRED — Supabase PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SECRET_KEY=your-random-secret-key-at-least-64-characters-long

# JWT token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# REQUIRED: Google OAuth Credentials (for server-side redirect flow)
#
# INSTRUCTIONS for Google Cloud Console (APIs & Services > Credentials):
# 1. Authorized JavaScript origins: MUST be your FRONTEND_URL (e.g. https://rrb-alp-prep.vercel.app)
# 2. Authorized redirect URIs: MUST be exactly your backend base URL + /api/auth/google/callback
#    (e.g., https://api.rrb-alp-prep.com/api/auth/google/callback)
#
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Frontend CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000

# ─── AI — Google Gemini ────────────────────────────────────────────────────────
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.8-flash

# ─── Object Storage — Supabase Storage (S3-compatible) ─────────────────────────
STORAGE_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=your-supabase-storage-access-key
STORAGE_SECRET_KEY=your-supabase-storage-secret-key
STORAGE_BUCKET=rrb-alp-pdfs
STORAGE_REGION=ap-south-1

# ─── PDF Processing ────────────────────────────────────────────────────────────
MAX_PDF_SIZE_MB=50

# ─── Environment ───────────────────────────────────────────────────────────────
# Options: development | production
ENVIRONMENT=development

# ─── Redis (for Celery background jobs — Phase 5) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
