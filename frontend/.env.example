# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_API_URL: The base URL for the FastAPI backend REST API
NEXT_PUBLIC_API_URL="https://rrb-alp-web.onrender.com"

# NEXT_PUBLIC_USE_MOCKS: Set to true only if testing without a running backend
NEXT_PUBLIC_USE_MOCKS="false"
